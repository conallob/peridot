<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.peridot.peridotd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/peridotd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/peridotd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/peridotd.err.log</string>
</dict>
</plist>
